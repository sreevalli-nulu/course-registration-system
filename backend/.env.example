# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string from Supabase / Neon, e.g.:
# postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/course_registration

# Generate a random secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
